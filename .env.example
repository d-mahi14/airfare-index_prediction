# =============================================================
# Real-Time Indian Domestic Airfare Price Index (APIx)
# Environment Configuration
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# --- PostgreSQL (Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airfare_db
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=change_me_in_dot_env

# Constructed automatically from the above by config.py
# DATABASE_URL=postgresql+psycopg2://airfare_user:change_me@localhost:5432/airfare_db

# --- Application ---
APP_ENV=development         # development | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
BASE_YEAR=2024              # MoSPI CPI reference base year

# --- Collection ---
COLLECTION_LEAD_DAYS=1,7,15,30,45
DEFAULT_CURRENCY=INR
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
REFERENCE_DATA_PATH=data/reference

# --- Rate Limiting ---
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_MAX_RETRIES=3

# --- API Keys (optional external services) ---
# EXAMPLE_API_KEY=your_key_here
